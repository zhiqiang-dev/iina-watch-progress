{
  "name": "iina-watch-progress",
  "version": "0.1.2",
  "private": true,
  "description": "Persistent local video progress for IINA",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "package": "pnpm build && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "iina-plugin-definition": "0.99.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
